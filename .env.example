# ==============================================================
# SISTEM PENJADWALAN & ROTASI LEMBUR TIM - PLN ICON PLUS
# Template Variabel Lingkungan (Environment Variables)
# Salin berkas ini menjadi .env.local untuk pengembangan lokal
# ==============================================================

# 1. Database: isi connection string privat dari lingkungan Anda.
DATABASE_URL=""

# 2. Better Auth Configuration
# Wajib secret acak minimal 32 karakter; jangan pakai nilai contoh atau commit secret.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Neon Object Storage (Bucket S3-Compatible: uploads - Private)
NEON_STORAGE_ENDPOINT=""
NEON_STORAGE_REGION="us-east-2"
NEON_STORAGE_BUCKET="uploads"
NEON_STORAGE_ACCESS_KEY_ID=""
NEON_STORAGE_SECRET_ACCESS_KEY=""
